---
import { text, attrs, imageAttrs, localizedPath } from "../utils/i18n";

const { sku, lineSlug, image, alt, variant } = Astro.props;
const isUpcoming = variant === "upcoming";
const language = Astro.locals.language === "en" ? "en" : "zh";
const isCareLine = lineSlug === "carekeep";
const hasDetails = isCareLine && !sku.comingSoon;
const name = sku.displayName || sku.title;
const href = localizedPath(`/products/${sku.slug}/`, language);
const card = sku.card || {};
const rows = isUpcoming ? [
  { label: { zh: "特点", en: "Features" }, value: sku.body }
] : [
  { label: { zh: "尺寸", en: "Size" }, value: card.size },
  { label: { zh: "抽数", en: "Pack quantity" }, value: card.packQuantity }
].filter(row => hasDetails && row.value);
---

<article class:list={["series-product-card", !hasDetails && !isUpcoming && "is-development", isUpcoming && "is-upcoming"]} data-product-slug={sku.slug}>
  {hasDetails ? (
    <a class="series-product-media product-card-media" href={href} aria-label={text(name, language)}>
      <img src={image} {...imageAttrs(alt)} loading="lazy" decoding="async" />
    </a>
  ) : (
    <div class="series-product-media product-card-media">
      <img src={image} {...imageAttrs(alt)} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="series-product-copy">
    <span class="series-product-code" aria-label={language === "en" ? "Item code" : "货号"}>
      {isUpcoming ? "COMING SOON" : isCareLine ? card.itemNo || "" : ""}
    </span>
    <h3>
      {hasDetails ? <a href={href}>{text(name, language)}</a> : <span {...attrs(name)}>{text(name, language)}</span>}
    </h3>
    {!hasDetails && !isUpcoming && <p class="series-development-copy" {...attrs(sku.body)}>{text(sku.body, language)}</p>}
    {rows.length > 0 && <dl>
      {rows.map((row) => (
        <div>
          <dt {...attrs(row.label)}>{text(row.label, language)}</dt>
          <dd {...attrs(row.value)}>{text(row.value, language)}</dd>
        </div>
      ))}
    </dl>}
    {hasDetails ? (
      <a class="sku-card-link" href={href} data-zh="查看详情" data-en="View details">{language === "en" ? "View details" : "查看详情"}</a>
    ) : isUpcoming ? (
      <span class="sku-card-link is-disabled" aria-disabled="true" data-zh="即将上市" data-en="COMING SOON">{language === "en" ? "COMING SOON" : "即将上市"}</span>
    ) : (
      <div class="series-development-actions">
        <a class="sku-card-link" href={localizedPath("/contact/", language)} data-zh="咨询定制开发" data-en="Discuss product development">{language === "en" ? "Discuss product development" : "咨询定制开发"}</a>
      </div>
    )}
  </div>
</article>

<style>
  .series-product-card { display:grid; grid-template-rows:auto 1fr; min-width:0; }
  .series-product-media { position:relative; }
  .series-product-media img { transition:transform .42s ease; }
  .series-product-media:hover img,.series-product-media:focus-visible img { transform:scale(1.025); }
  .series-product-copy { display:flex; flex-direction:column; min-height:clamp(240px,15.1vw,275px); padding-top:15px; border-top:1px solid rgba(142,142,149,.48); }
  .series-product-copy:lang(en) { min-height:300px; }
  .series-product-code { display:block; min-height:22px; color:var(--color-slate-mist); font-size:15px; line-height:22px; font-weight:700; }
  .series-product-copy h3 { margin:8px 0 12px; font-size:clamp(22px,1.65vw,28px); line-height:1.08; letter-spacing:0; overflow-wrap:break-word; }
  .series-product-copy h3 a { color:inherit; }
  .series-product-copy h3 a:hover,.series-product-copy h3 a:focus-visible { color:#007c7a; }
  .series-product-copy dl { display:grid; margin:auto 0 0; border-top:1px solid rgba(142,142,149,.48); font-size:15px; line-height:1.4; }
  .series-development-copy { font-size:15px; line-height:1.6; color:var(--color-slate-mist); margin:0 0 18px; }
  .series-development-actions { display:flex; justify-content:center; margin-top:auto; padding-top:22px; border-top:1px solid rgba(142,142,149,.48); }
  .series-development-actions .sku-card-link { margin-top:0; }
  .series-product-copy dl div { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,2fr) minmax(0,1fr); align-items:center; padding:8px 0; border-bottom:1px solid rgba(142,142,149,.48); }
  .series-product-copy dt,.series-product-copy dd { margin:0; min-width:0; }
  .series-product-copy dt { grid-column:1; font-weight:700; }
  .series-product-copy dd { grid-column:2; color:var(--color-slate-mist); text-align:center; overflow-wrap:break-word; }
  .is-upcoming .series-product-copy dl div { grid-template-columns:54px minmax(0,1fr); gap:12px; align-items:start; min-height:76px; }
  .is-upcoming .series-product-copy dd { text-align:left; font-size:14px; line-height:1.5; }
  .sku-card-link { align-self:center; margin-top:15px; padding-bottom:5px; font-size:15px; line-height:1.3; text-align:center; }
  .sku-card-link.is-disabled { opacity:1; cursor:default; user-select:none; }
  @media(max-width:900px) { .series-product-copy {min-height:275px;} .series-product-copy h3 {font-size:26px;} }
  @media(max-width:640px) { .series-product-copy h3 {font-size:24px;} }
  @media(prefers-reduced-motion:reduce) { .series-product-media img {transition:none;} }
</style>
