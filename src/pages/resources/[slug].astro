---
import { searchConfig } from "../../utils/search-config.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaCaption from "../../components/MediaCaption.astro";
import GlossaryLinkedText from "../../components/GlossaryLinkedText.astro";
import resources from "../../data/site/resources.json" with { type: "json" };
import authors from "../../data/site/authors.json";
import products from "../../data/site/products.json" with { type: "json" };
import { text, attrs, imageAttrs, ariaAttrs, localizedPath } from "../../utils/i18n";
import { sortResourcesByDate, resourceDisplayDate } from "../../utils/resources.js";
import { getProductLinePublicSlug, resolveProductLineMedia } from "../../utils/productLines.js";
import { absoluteUrl, resourceDate, schemaIds, buildAuthorNode } from "../../utils/schema";

const entries = [
  ...sortResourcesByDate(resources.news).map((item) => ({ item, type: { zh: "新闻", en: "News" }, meta: item.date })),
  ...sortResourcesByDate(resources.blogs).map((item) => ({ item, type: { zh: "博客", en: "Blog" }, meta: item.date || item.category }))
];
const entry = entries.find(({ item }) => item.slug === Astro.params.slug);

if (!entry) {
  return new Response("Resource not found", { status: 404 });
}

const { item, type, meta } = entry;
const sections = (Array.isArray(item.sections) ? item.sections : []).map((section) => ({
  ...section,
  ...(section.pageWindow ? { pageWindow: resolveProductLineMedia(section.pageWindow) } : {})
}));
const related = entries.filter((candidate) => candidate.item.slug !== item.slug).slice(0, 3);
const resourceSeo = {
  "vinner-personal-cleansing-care-line": {
    title: { zh: "维尼个人清洁护理产品线发布 | 维尼健康", en: "VINNER Personal Cleansing & Care Line Launch" },
    description: {
      zh: "了解 VINNER 面向住院、老年照护、新生儿与日常肌肤护理推出的免冲洗沐浴、洗发、失禁护理和婴儿湿巾产品。",
      en: "Discover VINNER's rinse-free bathing, shampoo, incontinence-care, and baby wipes for hospitals, elderly care, newborns, and everyday skin cleansing."
    }
  },
  "vinner-team-whx-dubai-2026": {
    title: { zh: "VINNER 团队亮相 WHX Dubai 2026", en: "VINNER at WHX Dubai 2026" },
    description: {
      zh: "回顾 VINNER 团队在 WHX Dubai 2026 展会与全球医疗健康客户围绕产品、项目和供应合作开展的交流。",
      en: "See how VINNER met global healthcare customers at WHX Dubai 2026 to discuss products, projects, and supply partnerships."
    }
  },
  "vinner-gama-healthcare-strategic-discussion": {
    title: { zh: "维尼健康访问 GAMA Healthcare | 维尼健康", en: "VINNER Visits GAMA Healthcare" },
    description: {
      zh: "维尼健康董事长刘春静女士访问 GAMA Healthcare，双方围绕长期合作与未来业务发展机会开展战略交流。",
      en: "VINNER chairwoman Liu Chunjing visited GAMA Healthcare for strategic discussions on long-term cooperation and future opportunities."
    }
  },
  "rinse-free-bathing-products-us-care-market": {
    title: { zh: "美国医疗养老免冲洗沐浴产品与合规 | 维尼健康", en: "Rinse-Free Bathing Products in U.S. Care | VINNER" },
    description: {
      zh: "分析美国医疗与养老市场免冲洗沐浴产品的需求，涵盖院感防控、采购、法规合规与照护体验。",
      en: "Explore demand for rinse-free bathing products in U.S. healthcare and elderly care, including infection control, procurement, compliance, and dignity."
    }
  },
  "bacterial-outbreaks-environmental-infection-control": {
    title: { zh: "细菌暴发与医疗环境感染控制 | 维尼健康", en: "Bacterial Outbreaks & Environmental Infection Control" },
    description: {
      zh: "近期发表的三项细菌暴发调查分别发生在医院 ICU、社区服务场所和大型综合医院，耐药菌正在持续给医疗机构和公共卫生系统带来挑战。这些调查一次又一次将感染传播与患者周边环境、医疗设备、高频接触表面以及感染控制措施联系在一起。",
      en: "Explore three bacterial outbreak investigations linking drug-resistant infections to healthcare surfaces, equipment, and environmental hygiene."
    }
  },
  "how-to-choose-compliant-us-cosmetics-oem-supplier": {
    title: { zh: "美国化妆品 OEM/ODM 合规检查清单 | 维尼健康", en: "U.S. Cosmetics OEM/ODM Compliance Checklist | VINNER" },
    description: {
      zh: "面向计划进入美国市场的化妆品品牌，梳理选择 OEM/ODM 制造商时应核查的 MoCRA、工厂注册、质量与供应能力。",
      en: "A practical checklist for evaluating MoCRA readiness, facility registration, quality systems, and supply capability in a U.S. cosmetics OEM/ODM partner."
    }
  },
  "eu-forced-labour-regulation-preparation": {
    title: { zh: "欧盟强迫劳动条例实施准备 | 维尼健康", en: "Preparing for the EU Forced Labour Regulation | VINNER" },
    description: {
      zh: "解读欧盟《禁止强迫劳动产品条例》的适用范围、判断标准、进口商准备事项及供应商证据体系。",
      en: "An overview of the EU Forced Labour Regulation, its scope, forced-labour indicators, importer preparation and supplier evidence."
    }
  },
};
const seo = item.meta || resourceSeo[item.slug] || {
  title: { zh: `${text(item.title, "zh")} | 维尼健康`, en: `${text(item.title, "en")} | VINNER` },
  description: item.body
};
const title = seo.title;
const description = seo.description;
const articleParagraphs = [
  item.body,
  ...sections.flatMap((section) => [section.body, ...(section.paragraphs || []), ...(section.paragraphsAfter || [])])
].filter(Boolean);
const gallery = Array.isArray(item.gallery) ? item.gallery : [];
const hasRichSections = sections.length > 0;
const isReferenceSection = (section) => {
  const headingZh = text(section.heading, "zh");
  const headingEn = text(section.heading, "en");
  return /^(references?|references and data sources|参考文献|参考资料)/i.test(`${headingZh} ${headingEn}`.trim());
};
const productBySlug = new Map(
  products.lines.flatMap((line) => line.skus || []).map((product) => [product.slug, product])
);
const productLineBySlug = new Map(
  products.lines.flatMap((line) => (line.skus || []).map((product) => [product.slug, line]))
);
const lineBySlug = new Map(products.lines.map((line) => [line.slug, line]));
const productSlugsForSection = (section) => [
  ...(Array.isArray(section.productSlugs) ? section.productSlugs : []),
  ...(section.productSlug && !section.productSlugs?.includes(section.productSlug) ? [section.productSlug] : [])
];
const resourceMediaLayoutClass = (count) => `resource-media-count-${Math.min(count, 4)}`;
const relatedTitle = type.zh === "博客"
  ? { zh: "更多博客。", en: "More blog posts." }
  : { zh: "更多新闻。", en: "More news." };
const siteUrl = searchConfig.siteUrl;
const language = Astro.locals.language || "zh";
const ids = schemaIds(siteUrl);
const pageUrl = absoluteUrl(localizedPath(`/resources/${item.slug}/`, language), siteUrl);
const articleId = `${pageUrl}#article`;
const author = item.authorId ? authors[item.authorId] : undefined;
const articleAuthorIds = [...new Set([item.authorId, ...(item.coauthorIds || [])])].filter(id => id && authors[id]);
if (type.zh === "博客" && !author) throw new Error(`Missing author for ${item.slug}`);
const publishedAt = resourceDate(item.date);
const modifiedAt = resourceDate(item.updatedAt);
const mentionedProducts = [...new Set(sections.flatMap((section) => productSlugsForSection(section)))]
  .map((slug) => productBySlug.get(slug))
  .filter((product) => product && !product.comingSoon)
  .map((product) => ({
    "@id": `${absoluteUrl(localizedPath(`/products/${product.slug}/`, language), siteUrl)}#product`
  }));
const articleSchema = {
  "@type": type.zh === "新闻" ? "NewsArticle" : "BlogPosting",
  "@id": articleId,
  headline: text(item.title, language),
  description: text(description, language),
  image: absoluteUrl(item.image, siteUrl),
  url: pageUrl,
  mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
  datePublished: publishedAt,
  ...(modifiedAt ? { dateModified: modifiedAt } : {}),
  author: articleAuthorIds.length > 1
    ? articleAuthorIds.map(id => buildAuthorNode(id, siteUrl, language))
    : author ? buildAuthorNode(item.authorId, siteUrl, language) : { "@id": ids.organization },
  publisher: { "@id": ids.organization },
  articleSection: item.category ? text(item.category, language) : text(type, language),
  inLanguage: language === "en" ? "en" : "zh-CN",
  isAccessibleForFree: true,
  ...(mentionedProducts.length ? { mentions: mentionedProducts } : {})
};
---

<BaseLayout
  title={title}
  description={description}
  image={item.image}
  imageAlt={item.alt}
  imageWidth={item.imageWidth}
  imageHeight={item.imageHeight}
  ogType="article"
  pageType="ItemPage"
  breadcrumbs={[
    { name: { zh: "首页", en: "Home" }, path: "/" },
    { name: { zh: "资源", en: "Resources" }, path: "/resources/" },
    { name: item.title, path: `/resources/${item.slug}/` }
  ]}
  mainEntityId={articleId}
  schema={articleSchema}
  articleMeta={{ author: author ? text(author.name, language) : undefined, publishedAt, modifiedAt }}
>
  <article class="resource-detail">
    <header class="resource-detail-hero">
      <div class="resource-detail-copy">
        <a class="back-link" href="/resources/" data-zh="返回资源" data-en="Back to resources">返回资源</a>
        <p class="section-kicker" {...attrs(type)}>{text(type)}</p>
        <h1 {...attrs(item.title)}>
          <span>{text(item.title)}</span>
          {item.subtitle && <span class="resource-detail-title-line" {...attrs(item.subtitle)}>{text(item.subtitle)}</span>}
        </h1>
        <p class="resource-detail-meta"><time datetime={publishedAt}>{resourceDisplayDate(meta, language)}</time>{modifiedAt && <><br /><span data-zh="更新于 " data-en="Updated ">更新于 </span><time datetime={modifiedAt}>{modifiedAt}</time></>}</p>
        {articleAuthorIds.map(authorId => (
          <div class="resource-detail-author">
            <strong><a href={`/contact/#${authorId}`} rel="author" {...attrs(authors[authorId].name)}>{text(authors[authorId].name)}</a></strong>
            <span {...attrs(authors[authorId].role)}>{text(authors[authorId].role)}</span>
          </div>
        ))}
        <p class="resource-detail-summary"><GlossaryLinkedText value={item.body} context="hero" /></p>
      </div>
      <figure class="resource-detail-image">
        <img src={item.image} {...imageAttrs(item.alt)} width={item.imageWidth} height={item.imageHeight} fetchpriority="high" decoding="async" />
        <MediaCaption caption={item.imageCaption || item.title} />
      </figure>
    </header>

    <section class="resource-article-body resource-article-story" id="article" {...ariaAttrs({ zh: "文章正文", en: "Article body" })}>
      <div class="resource-article-content">
        {hasRichSections ? (
          <>
            {item.repeatSummaryInBody !== false && (
              <p class="resource-article-lead"><GlossaryLinkedText value={item.body} context="paragraph" /></p>
            )}
            {sections.map((section) => (
              <section class:list={["resource-day-entry", section.level === 2 && "resource-day-entry-subsection"]}>
                <div class="resource-day-copy">
                  {section.heading && (section.level === 1 ? (
                    <h2 {...attrs(section.heading)}>{text(section.heading)}</h2>
                  ) : section.level === 2 ? (
                    <h3 {...attrs(section.heading)}>{text(section.heading)}</h3>
                  ) : (
                    <h4 {...attrs(section.heading)}>{text(section.heading)}</h4>
                  ))}
                  {section.body && <p><GlossaryLinkedText value={section.body} context="body" /></p>}
                  {Array.isArray(section.paragraphs) && section.paragraphs.map((paragraph) => (
                    <p><GlossaryLinkedText value={paragraph} context="paragraph" /></p>
                  ))}
                  {section.pageWindow && (
                    <div class="resource-page-window" {...ariaAttrs({ zh: "关联页面", en: "Related page" })}>
                      <a class="article-product-window article-page-window" href={section.pageWindow.href}>
                        <figure class="article-product-window-media">
                          <img src={section.pageWindow.image} {...imageAttrs(section.pageWindow.alt)} width={section.pageWindow.imageWidth} height={section.pageWindow.imageHeight} loading="lazy" decoding="async" />
                        </figure>
                        <span class="article-product-window-copy">
                          <span class="article-product-window-kicker" {...attrs(section.pageWindow.kicker)}>{text(section.pageWindow.kicker)}</span>
                          <strong {...attrs(section.pageWindow.title)}>{text(section.pageWindow.title)}</strong>
                          <span class="article-product-window-description" {...attrs(section.pageWindow.body)}>{text(section.pageWindow.body)}</span>
                          <span
                            class="article-product-window-link"
                            {...attrs(section.pageWindow.link)}
                          >
                            {text(section.pageWindow.link)}
                          </span>
                        </span>
                      </a>
                    </div>
                  )}
                  {[...(section.linkedParagraph ? [section.linkedParagraph] : []), ...(section.linkedParagraphs || [])].map(linked => (
                    <p class="resource-linked-paragraph">
                      <a href={linked.href} {...attrs(linked.text)}>
                        {text(linked.text)}
                      </a>
                    </p>
                  ))}
                  {Array.isArray(section.bullets) && (
                    <ul class="resource-article-list">
                      {section.bullets.map((bullet) => (
                        <li>{isReferenceSection(section) ? text(bullet, language) : <GlossaryLinkedText value={bullet} context="bullet" />}</li>
                      ))}
                    </ul>
                  )}
                  {Array.isArray(section.paragraphsAfter) && section.paragraphsAfter.map((paragraph) => (
                    <p><GlossaryLinkedText value={paragraph} context="paragraph" /></p>
                  ))}
                  {Array.isArray(section.subsections) && section.subsections.map((subsection) => (
                    <div class="resource-article-subsection">
                      <h4 {...attrs(subsection.heading)}>{text(subsection.heading)}</h4>
                      {subsection.body && <p><GlossaryLinkedText value={subsection.body} context="body" /></p>}
                      {Array.isArray(subsection.paragraphs) && subsection.paragraphs.map((paragraph) => (
                        <p><GlossaryLinkedText value={paragraph} context="paragraph" /></p>
                      ))}
                      {Array.isArray(subsection.bullets) && (
                        <ul class="resource-article-list">
                          {subsection.bullets.map((bullet) => (
                            <li><GlossaryLinkedText value={bullet} context="bullet" /></li>
                          ))}
                        </ul>
                      )}
                      {Array.isArray(subsection.paragraphsAfter) && subsection.paragraphsAfter.map((paragraph) => (
                        <p><GlossaryLinkedText value={paragraph} context="paragraph" /></p>
                      ))}
                    </div>
                  ))}
                  {Array.isArray(section.table?.headers) && Array.isArray(section.table?.rows) && (
                    <div class="resource-data-table-wrap">
                      <table class="resource-data-table">
                        <thead>
                          <tr>{section.table.headers.map((header) => <th><GlossaryLinkedText value={header} context="table" /></th>)}</tr>
                        </thead>
                        <tbody>
                          {section.table.rows.map((row) => (
                            <tr>{row.map((cell) => <td><GlossaryLinkedText value={cell} context="table" /></td>)}</tr>
                          ))}
                        </tbody>
                      </table>
                      {section.table.caption && <MediaCaption caption={section.table.caption} />}
                      {section.table.download && <a class="resource-table-download" href={section.table.download.href} download {...attrs(section.table.download.label)}>{text(section.table.download.label)}</a>}
                    </div>
                  )}
                  {productSlugsForSection(section).map((productSlug) => productBySlug.has(productSlug) && (() => {
                    const product = productBySlug.get(productSlug);
                    const productLine = productLineBySlug.get(product.slug);
                    const productHref = product.comingSoon
                      ? `/products/series/${getProductLinePublicSlug(productLine?.slug || "medikeep", language)}/#products`
                      : `/products/${product.slug}/`;
                    const productImage = product.comingSoon && productLine?.slug !== "oem-odm"
                      ? product.image
                      : product.image;
                    return (
                      <a class="article-product-window" href={productHref}>
                        <figure class="article-product-window-media">
                          <img src={productImage} {...imageAttrs(product.alt)} loading="lazy" />
                        </figure>
                        <span class="article-product-window-copy">
                          <span class="article-product-window-kicker" data-zh="关联产品" data-en="Related product">关联产品</span>
                          <strong {...attrs(product.displayName || product.title)}>{text(product.displayName || product.title)}</strong>
                          <span class="article-product-window-description" {...attrs(product.body)}>{text(product.body)}</span>
                          <span
                            class="article-product-window-link"
                            data-zh={product.comingSoon ? "查看产品线" : "查看产品"}
                            data-en={product.comingSoon ? "View product line" : "View product"}
                          >
                            {product.comingSoon ? "查看产品线" : "查看产品"}
                          </span>
                        </span>
                      </a>
                    );
                  })())}
                  {section.productLineSlug && lineBySlug.has(section.productLineSlug) && (() => {
                    const productLine = lineBySlug.get(section.productLineSlug);
                    return (
                      <a class="article-product-window article-product-line-window" href={`/products/series/${getProductLinePublicSlug(productLine.slug, language)}/`}>
                        <figure class="article-product-window-media">
                          <img src={productLine.image} {...imageAttrs(productLine.alt)} width={productLine.imageWidth} height={productLine.imageHeight} loading="lazy" decoding="async" />
                        </figure>
                        <span class="article-product-window-copy">
                          <span class="article-product-window-kicker" data-zh="关联产品线" data-en="Related product line">关联产品线</span>
                          <strong {...attrs(productLine.name)}>{text(productLine.name)}</strong>
                          <span class="article-product-window-description" {...attrs(productLine.summary)}>{text(productLine.summary)}</span>
                          <span
                            class="article-product-window-link"
                            data-zh="查看产品线"
                            data-en="View product line"
                          >
                            查看产品线
                          </span>
                        </span>
                      </a>
                    );
                  })()}
                </div>
                {Array.isArray(section.media) && section.media.length > 0 && (
                  <div class:list={["resource-day-media", resourceMediaLayoutClass(section.media.length)]}>
                    {section.media.map((media) => (
                      <figure class:list={[media.image === "/assets/blog/blog5/eu-packaging-waste-2023.png" && "resource-diagram"]}>
                        <img src={media.image} {...imageAttrs(media.alt)} />
                        <MediaCaption caption={media.caption} source={media.source} />
                      </figure>
                    ))}
                  </div>
                )}
              </section>
            ))}
          </>
        ) : (
          articleParagraphs.map((paragraph) => (
            <p><GlossaryLinkedText value={paragraph} context="paragraph" /></p>
          ))
        )}
      </div>
    </section>

    {item.quote && (
      <aside class="resource-article-quote">
        <blockquote><GlossaryLinkedText value={item.quote} context="quote" /></blockquote>
      </aside>
    )}

    {gallery.length > 0 && (
      <section
        class:list={["resource-article-gallery", resourceMediaLayoutClass(gallery.length)]}
        {...ariaAttrs({ zh: "文章图片画廊", en: "Article gallery" })}
      >
        {gallery.map((media) => (
          <figure>
            <img src={media.image} {...imageAttrs(media.alt)} />
            <MediaCaption caption={media.caption} source={media.source} />
          </figure>
        ))}
      </section>
    )}

  </article>

  <section class="product-detail-section related-products resource-related-section" aria-labelledby="related-resources-title">
    <div class="detail-split-heading">
      <p class="section-kicker" data-zh="继续阅读" data-en="Keep reading">继续阅读</p>
      <h2 id="related-resources-title" {...attrs(relatedTitle)}>{text(relatedTitle)}</h2>
    </div>
      <div class="related-resource-grid">
        {related.map((entry) => (
          <a class="related-resource-card" href={`/resources/${entry.item.slug}/`}>
          <figure>
            <img src={entry.item.image} {...imageAttrs(entry.item.alt)} />
          </figure>
            <span>{resourceDisplayDate(entry.meta, language)}</span>
            <h3 {...attrs(entry.item.title)}>{text(entry.item.title)}</h3>
          </a>
        ))}
    </div>
  </section>
</BaseLayout>
