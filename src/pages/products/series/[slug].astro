---
import { searchConfig } from "../../../utils/search-config.mjs";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GlossaryLinkedText from "../../../components/GlossaryLinkedText.astro";
import ProductCard from "../../../components/ProductCard.astro";
import UpcomingProductCard from "../../../components/UpcomingProductCard.astro";
import products from "../../../data/site/products.json" with { type: "json" };
import { text, attrs, imageAttrs, ariaAttrs, localizedPath } from "../../../utils/i18n";
import { getProductLineMeta, getProductLinePublicSlug } from "../../../utils/productLines";
import { absoluteUrl, buildProductBrand, schemaIds } from "../../../utils/schema";
import { getProductCardImage, getProductCardAlt } from "../../../utils/productImages.mjs";

const language = Astro.locals.language || "zh";
const requestedSlug = Astro.params.slug;
const entry = products.lines
  .map((line) => ({ line, meta: getProductLineMeta(line) }))
  .find(({ meta }) => meta.slug === requestedSlug || getProductLinePublicSlug(meta.slug, language) === requestedSlug);

if (!entry) {
  return new Response("Product line not found", { status: 404 });
}

const { line, meta } = entry;
const publicSlug = getProductLinePublicSlug(meta.slug, language);
if (requestedSlug !== publicSlug) {
  return Astro.redirect(`${localizedPath(`/products/series/${publicSlug}/`, language)}${Astro.url.search}`, 301);
}
const skus = Array.isArray(line.skus) ? line.skus : [];
const pageTitles = {
  zh: {
    medikeep: "感控消毒 | 维尼健康",
    carekeep: "清洁护理 | 维尼健康",
    indukeep: "工业擦拭 | 维尼健康",
    "oem-odm": "定制开发 | 维尼健康"
  },
  en: {
    medikeep: "INFECTION CONTROL | VINNER",
    carekeep: "CLEANSING & CARE | VINNER",
    indukeep: "INDUSTRIAL WIPING | VINNER",
    "oem-odm": "OEM/ODM Wipes & Solutions | VINNER"
  }
};
const pageTitle = {
  zh: pageTitles.zh[meta.slug] || `${meta.name.zh}擦拭产品线 | 维尼健康`,
  en: pageTitles.en[meta.slug] || `${meta.name.en} Wipes & Solutions | VINNER`
};
const englishDescriptions = {
  medikeep: "Explore VINNER infection-control wipes for public spaces, hospital environments, medical-device surface disinfection, and skin antisepsis.",
  indukeep: "Explore VINNER industrial wipes for general maintenance, heavy-duty soil removal, solvents, and cleanroom precision wiping.",
  "oem-odm": "VINNER manufactures medical-device and surface disinfection wipes, baby wipes, skin care wipes, and innovative wipes like cooling or sneaker care wipes."
};
const chineseDescriptions = {
  medikeep: "维尼健康的感控消毒产品包括公共场所消毒、医院环境消毒与医疗器械表面消毒湿巾与人体皮肤除菌湿巾。",
  "oem-odm": "维尼健康具有超过20年代工生产经验，自主研发了超过500款不同用途湿巾配方。可代工生产全领域全品类湿巾，从医疗器械与环境消毒湿巾到个人皮肤清洁护理，再到多种创新型湿巾如清凉湿巾、球鞋清洁湿巾等。"
};
const pageDescription = {
  zh: chineseDescriptions[meta.slug] || `${meta.summary.zh}${meta.products.zh}`,
  en: englishDescriptions[meta.slug] || `${meta.summary.en} ${meta.products.en}`
};
const isOemLine = meta.slug === "oem-odm";
const isUpcomingLine = ["medikeep", "indukeep"].includes(meta.slug);
const getSkuPrimaryImage = (sku) => getProductCardImage(sku, meta.slug);
const getSkuPrimaryAlt = (sku) => getProductCardAlt(sku, meta.slug);
const hasProducts = skus.length > 0;
const hasPlannedProducts = skus.some((sku) => sku.comingSoon);
const skuName = (sku) => sku.displayName || { zh: sku.title, en: sku.title };
const productGroups = skus.reduce((groups, sku) => {
  const key = sku.group?.en || "default";
  let group = groups.find((item) => item.key === key);

  if (!group) {
    group = { key, label: sku.group || null, items: [] };
    groups.push(group);
  }

  group.items.push(sku);
  return groups;
}, []);
const siteUrl = searchConfig.siteUrl;
const ids = schemaIds(siteUrl);
const pageUrl = absoluteUrl(localizedPath(`/products/series/${publicSlug}/`, language), siteUrl);
const productListId = `${pageUrl}#products`;
const productNodes = skus.map((sku) => {
  const detailUrl = sku.comingSoon
    ? undefined
    : absoluteUrl(localizedPath(`/products/${sku.slug}/`, language), siteUrl);
  const itemId = detailUrl ? `${detailUrl}#product` : `${pageUrl}#product-${sku.slug}`;
  const itemNumber = !["PLANNED", "OEM/ODM"].includes(sku.itemNo) ? sku.itemNo : undefined;

  return {
    "@type": sku.comingSoon ? "Service" : "Product",
    "@id": itemId,
    name: text(skuName(sku), language),
    description: text(sku.body || sku.intro || meta.summary, language),
    image: absoluteUrl(getSkuPrimaryImage(sku), siteUrl),
    ...(!sku.comingSoon && itemNumber ? { sku: itemNumber } : {}),
    ...(!sku.comingSoon && sku.code ? { mpn: sku.code } : {}),
    ...(detailUrl ? {
      url: detailUrl,
      mainEntityOfPage: { "@id": `${detailUrl}#webpage` }
    } : {}),
    ...(!sku.comingSoon ? { brand: buildProductBrand(sku.code, sku.title, siteUrl), manufacturer: { "@id": ids.organization } } : { provider: { "@id": ids.organization }, serviceType: language === "en" ? "Wet wipes product development" : "湿巾产品定制开发", url: absoluteUrl(localizedPath("/contact/", language), siteUrl) }),
    category: text(meta.name, language)
  };
});
const seriesSchema = [
  {
    "@type": "ItemList",
    "@id": productListId,
    name: language === "en" ? `${meta.name.en} products` : `${meta.name.zh}产品`,
    numberOfItems: productNodes.length,
    itemListElement: productNodes.map((node, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: { "@id": node["@id"] }
    }))
  },
  ...productNodes
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={meta.image}
  imageAlt={meta.alt}
  imageWidth={meta.imageWidth}
  imageHeight={meta.imageHeight}
  pageType="CollectionPage"
  breadcrumbs={[
    { name: { zh: "首页", en: "Home" }, path: "/" },
    { name: { zh: "产品", en: "Products" }, path: "/products/" },
    { name: meta.name, path: `/products/series/${publicSlug}/` }
  ]}
  mainEntityId={productListId}
  schema={seriesSchema}
>
  <section class="page-hero page-hero-image series-page-hero" aria-labelledby="series-title">
    <img src={meta.image} {...imageAttrs(meta.alt)} width={meta.imageWidth} height={meta.imageHeight} fetchpriority="high" decoding="async" />
    <div class="page-hero-scrim"></div>
    <div>
      <a class="back-link back-link-on-media" href="/products/" data-zh="返回产品页" data-en="Back to products">返回产品页</a>
      <p class="eyebrow" {...attrs(meta.indexLabel)}>{text(meta.indexLabel)}</p>
      <h1 id="series-title" {...attrs(meta.name)}>{text(meta.name)}</h1>
      <p {...attrs(meta.title)}>{text(meta.title)}</p>
    </div>
  </section>

  <section id="products" class:list={["series-products", isOemLine && "is-oem-series"]} {...ariaAttrs({ zh: `${meta.name.zh}产品`, en: `${meta.name.en} products` })}>
    <h2 class="sr-only" data-zh="产品系列" data-en="Product range">产品系列</h2>
    {hasProducts ? (
      <div class="series-product-groups">
        {productGroups.map((group) => (
          <section class="series-product-group" {...(group.label ? ariaAttrs(group.label) : {})}>
            {group.label && (
              <header class="series-product-group-heading">
                <p class="section-kicker" data-zh="产品系列" data-en="Product Range">产品系列</p>
                <h3 {...attrs(group.label)}>{text(group.label)}</h3>
              </header>
            )}
            <div class:list={["series-product-grid", hasPlannedProducts && "is-planned-grid"]}>
              {group.items.map((sku) => isUpcomingLine ? (
                <UpcomingProductCard sku={sku} lineSlug={meta.slug} />
              ) : (
                <ProductCard sku={sku} lineSlug={meta.slug} image={getSkuPrimaryImage(sku)} alt={getSkuPrimaryAlt(sku)} />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="series-capability-grid">
        {meta.uses.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3 {...attrs(item)}>{text(item)}</h3>
            <p data-zh="根据目标市场、使用场景和包装需求继续拆解为可打样、可测试、可量产的项目简报。" data-en="Map target market, use case, and packaging needs into a sample-ready, test-ready, and production-ready project brief.">
              根据目标市场、使用场景和包装需求继续拆解为可打样、可测试、可量产的项目简报。
            </p>
          </article>
        ))}
      </div>
    )}
  </section>

    <section class="series-intro series-intro--compact" aria-labelledby="series-intro-title">
    <div class="series-intro-copy">
      <p class="section-kicker" data-zh="系列定位" data-en="Series Position">系列定位</p>
      <h2 id="series-intro-title" {...attrs(meta.summary)}>{text(meta.summary)}</h2>
      <p><GlossaryLinkedText value={meta.detail} context="body" /></p>
    </div>
    <div class="series-use-grid">
      {meta.uses.map((item) => (
        <article>
          <span class="use-icon" aria-hidden="true">+</span>
          <p><GlossaryLinkedText value={item} context="paragraph" /></p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
